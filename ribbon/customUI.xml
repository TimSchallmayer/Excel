<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui">
  <ribbon>
    <tabs>
      <tab id="physikAssistentTab" label="Physik-Assistent" insertAfterMso="TabView">
        <group id="physikDiagrammGroup" label="Diagramm">
          <button id="physikCreateChart" label="Diagramm erstellen" size="large" imageMso="ChartInsert" onAction="RibbonPhysikAssistent.CreateChart" screentip="Natives Excel-XY-Diagramm erstellen" supertip="Analysiert das aktive Tabellenblatt und legt ein bearbeitbares Excel-Diagramm an." />
          <button id="physikAnalyzeTable" label="Tabelle analysieren" imageMso="TableAnalyze" onAction="RibbonPhysikAssistent.AnalyzeTable" />
        </group>
        <group id="physikAIGroup" label="KI">
          <button id="physikTestAI" label="KI testen" imageMso="RefreshAll" onAction="RibbonPhysikAssistent.TestAI" />
          <button id="physikAISettings" label="KI-Einstellungen" imageMso="Properties" onAction="RibbonPhysikAssistent.OpenAISettings" />
        </group>
        <group id="physikAnalysisGroup" label="Auswertung">
          <button id="physikShowAnalysis" label="Analyse anzeigen" imageMso="ReviewShowAllComments" onAction="RibbonPhysikAssistent.ShowAnalysis" />
          <button id="physikSettings" label="Einstellungen" imageMso="TableProperties" onAction="RibbonPhysikAssistent.OpenSettings" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
